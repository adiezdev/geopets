---
import "../styles/global.css";
import { LANGS, DEFAULT_LANG, langPath, t } from "../lib/i18n/index.js";

interface Props { lang: string; dict: Record<string, any> }
const { lang, dict } = Astro.props;
const site = Astro.site!;
const abs = (p: string) => new URL(p, site).href;
const canonical = abs(langPath(lang));
const ogImage = abs(`/og-${lang}.png`);
const ogLocale = { en: "en_US", es: "es_ES" }[lang] ?? lang;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": abs("/#website"), url: abs("/"), name: "Geopets", inLanguage: LANGS },
    {
      "@type": "CreativeWork",
      name: "Geopets",
      url: canonical,
      inLanguage: lang,
      description: t(dict, "meta.description"),
      image: ogImage,
      license: "https://creativecommons.org/licenses/by/4.0/",
      author: { "@type": "Person", name: "Adiezdev", url: "https://adiez.dev" },
      isPartOf: { "@id": abs("/#website") },
    },
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{t(dict, "meta.title")}</title>
    <meta name="description" content={t(dict, "meta.description")} />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(langPath(l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(langPath(DEFAULT_LANG))} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Geopets" />
    <meta property="og:title" content={t(dict, "meta.title")} />
    <meta property="og:description" content={t(dict, "meta.description")} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t(dict, "meta.ogAlt")} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t(dict, "meta.title")} />
    <meta name="twitter:description" content={t(dict, "meta.description")} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@500;700&family=DM+Sans:wght@400;500;700&family=JetBrains+Mono:wght@400;600&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
