---
import { SHAPES, ALL_STATES, maskFrom, svgPet, fileName } from "../lib/geopets.js";
import { LANGS, langPath, t } from "../lib/i18n/index.js";

interface Props { lang: string; dict: Record<string, any> }
const { lang, dict } = Astro.props;
const site = Astro.site!.href; // ends with "/"
const heroStates = ["waving", "happy", "idle", "love", "thinking"];
const hero = Object.values(SHAPES).map((s, i) =>
  svgPet(maskFrom(s.fn), { color: s.color, legs: s.legs, shade: s.shade, state: heroStates[i] }, `h${i}-`));
const count = t(dict, "hero.count", { files: Object.keys(SHAPES).length * ALL_STATES.length, states: ALL_STATES.length });
const embed = `${site}pets/${fileName("cube", "typing", "svg")}`;
const client = { lang, site, dict };
// server-rendered so crawlers can follow every static SVG (the gallery itself renders client-side)
const files = Object.keys(SHAPES).flatMap((k) => ALL_STATES.map((st) => fileName(k, st, "svg")));
---
<div class="wrap">
  <header>
    <nav class="langs" aria-label={t(dict, "nav.switchLabel")}>
      {LANGS.map((l) => (
        <a href={langPath(l)} hreflang={l} lang={l} aria-current={l === lang ? "page" : undefined}>{t(dict, `nav.${l}`)}</a>
      ))}
    </nav>
    <div class="hero-row" id="hero" set:html={hero.join("")} />
    <h1>Geopets</h1>
    <p class="muted" style="max-width:62ch">{t(dict, "hero.lead")}</p>
    <div class="badges">
      <span class="badge">{t(dict, "hero.license")}</span>
      <span class="badge" id="count">{count}</span>
      <span class="badge">{t(dict, "hero.size")}</span>
    </div>
  </header>

  <section id="gallery">
    <div class="sec-head">
      <h2>{t(dict, "gallery.title")}</h2>
      <div class="row">
        <div class="chips" id="kindChips" role="group" aria-label={t(dict, "gallery.ariaKind")}></div>
        <div class="chips" id="shapeChips" role="group" aria-label={t(dict, "gallery.ariaShape")}></div>
        <button class="primary" id="packBtn">{t(dict, "btn.pack")}</button>
      </div>
    </div>
    <div class="row">
      <span class="mono muted">{t(dict, "gallery.formatLabel")}</span>
      <div class="chips fmtChips" role="group" aria-label={t(dict, "gallery.formatLabel")}></div>
    </div>
    <div class="grid" id="grid"></div>
    <details class="files">
      <summary>{t(dict, "gallery.files", { n: files.length })}</summary>
      <div>{files.map((f) => <a href={`/pets/${f}`}>{f}</a>)}</div>
    </details>
  </section>

  <section id="create">
    <div class="sec-head"><h2>{t(dict, "create.title")}</h2><p class="muted">{t(dict, "create.lead")}</p></div>
    <div class="creator">
      <div class="panel">
        <div class="field"><span>{t(dict, "create.preset")}</span><div class="chips" id="presetChips"></div></div>
        <div class="field"><span>{t(dict, "create.body")}</span><div class="editor" id="editor"></div></div>
        <div class="row">
          <button id="clearBtn">{t(dict, "btn.clear")}</button>
          <button id="invertBtn">{t(dict, "btn.invert")}</button>
          <button id="mirrorBtn">{t(dict, "btn.mirror")}</button>
        </div>
        <div class="row">
          <label class="field"><span>{t(dict, "create.color")}</span><input type="color" id="bodyColor" value={SHAPES.cube.color} /></label>
          <label class="field"><span>{t(dict, "create.eyes")}</span><input type="color" id="eyeColor" value="#1E1B2E" /></label>
          <label class="field" style="flex:1;min-width:140px"><span>{t(dict, "create.name")}</span><input type="text" id="petName" value={t(dict, "defaultPetName")} maxlength="40" /></label>
        </div>
      </div>
      <div class="panel">
        <div class="stage big" id="bigStage"></div>
        <div class="row" style="justify-content:center">
          <div class="chips fmtChips" role="group" aria-label={t(dict, "gallery.formatLabel")}></div>
        </div>
        <div class="row" style="justify-content:center">
          <button class="primary" id="dlBtn">{t(dict, "btn.downloadFmt", { ext: "SVG" })}</button>
          <button id="copyBtn">{t(dict, "btn.copySvg")}</button>
          <button id="myPackBtn">{t(dict, "btn.myPack")}</button>
        </div>
        <div class="field"><span>{t(dict, "create.state")}</span><div class="strip" id="strip"></div></div>
      </div>
    </div>
  </section>

  <section id="license">
    <h2>{t(dict, "license.title")}</h2>
    <div class="license">
      <div style="display:flex;flex-direction:column;gap:10px">
        <p>{t(dict, "license.p1before")} <a href={t(dict, "license.deed")} rel="license"><b>CC BY 4.0</b></a>{t(dict, "license.p1after")}</p>
        <p>{t(dict, "license.p2")} <span class="mono">{t(dict, "license.credit")}</span></p>
        <p class="muted">{t(dict, "license.note")}</p>
      </div>
      <pre><code>{`<img src="${embed}"
     width="120" alt="${t(dict, "license.snippetAlt")}">

<!-- ${t(dict, "license.snippetComment")} -->`}</code></pre>
    </div>
  </section>

  <footer class="foot">
    <span>{t(dict, "footer.madeBy")} <a href="https://adiez.dev">Adiezdev</a></span>
    <span class="mono muted">Geopets · CC BY 4.0</span>
  </footer>
</div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script type="application/json" id="i18n" set:html={JSON.stringify(client)} />
<script>import "../scripts/app.js";</script>
